generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Management
model User {
  id        Int     @id @default(autoincrement())
  email     String  @unique
  displayName String? @db.VarChar(150)
  password  String
  roleId    Int
  isActive  Boolean @default(true)
  isProtected Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role      Role    @relation(fields: [roleId], references: [id])
  products  Product[]
  productAnalytics ProductAnalytics[]
  news      News[]
  media     Media[]
  contacts  Contact[]
  createdPrivacyPolicies PrivacyPolicy[] @relation("CreatedPrivacyPolicies")
  createdTermsOfServices TermsOfService[] @relation("CreatedTermsOfServices")
  userPermissions UserPermission[]
}

// Role-Based Access Control
model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique // SuperAdmin, Admin, Editor
  permissions String? // JSON string of permissions
  users       User[]
  rolePermissions RolePermission[]
}

// -------------------- Products (catalog) --------------------
model ProductCategory {
  id          Int       @id @default(autoincrement()) @map("category_id")
  name        String    @map("category_name") @db.VarChar(150)
  slug        String    @unique @db.VarChar(64)
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  products    Product[]

  @@map("product_categories")
}

model Technology {
  id          Int       @id @default(autoincrement()) @map("tech_id")
  techName    String    @unique @map("tech_name") @db.VarChar(120)
  techLogo    String?   @map("tech_logo") @db.VarChar(2000)
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  products    ProductTechnology[]

  @@map("technologies")
}

model ProductTechnology {
  productId    Int
  technologyId Int
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([productId, technologyId])
  @@map("product_technologies")
}

model Product {
  id               Int       @id @default(autoincrement()) @map("product_id")
  productName      String    @map("product_name") @db.VarChar(200)
  productNameVi    String?   @map("product_name_vi") @db.VarChar(200)
  slug             String    @unique @db.VarChar(200)
  shortDescription String    @map("short_description") @db.VarChar(500)
  shortDescriptionVi String? @map("short_description_vi") @db.VarChar(500)
  fullDescription  String    @map("full_description") @db.Text
  fullDescriptionVi String? @map("full_description_vi") @db.Text
  imageUrls        Json      @default("[]")
  videoUrls        Json      @default("[]")
  demoLink         String?   @map("demo_link") @db.VarChar(2000)
  landingPageLink  String?   @map("landing_page_link") @db.VarChar(2000)
  embedDemoUrl     String?   @map("embed_demo_url") @db.VarChar(2000)
  categoryId       Int       @map("category_id")
  category         ProductCategory @relation(fields: [categoryId], references: [id])
  viewsCount       Int       @default(0) @map("views_count")
  demoClickCount   Int       @default(0) @map("demo_click_count")
  isFeatured       Boolean   @default(false) @map("is_featured")
  status           String    @default("Active")
  authorId         Int
  author           User      @relation(fields: [authorId], references: [id])
  seoTitle         String?   @db.VarChar(200)
  seoDescription     String?   @db.VarChar(500)
  seoKeywords        String?   @db.VarChar(500)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  technologies     ProductTechnology[]
  analyticsEvents  ProductAnalytics[]

  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model ProductAnalytics {
  id Int @id @default(autoincrement()) @map("analytics_id")
  productId Int @map("product_id")
  userId Int? @map("user_id")
  actionType String @map("action_type") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("timestamp")
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([actionType])
  @@index([createdAt])
  @@map("product_analytics")
}

// News
model News {
  id              Int     @id @default(autoincrement())
  title           String  @db.VarChar(150)
  titleVi         String? @map("title_vi") @db.VarChar(150)
  slug            String  @unique
  description     String  @db.VarChar(300)
  descriptionVi   String? @map("description_vi") @db.VarChar(300)
  content         String  @db.Text
  contentVi       String? @map("content_vi") @db.Text
  tags            String? // JSON array
  status          String  @default("Active")

  // Used for filtering/search sections (Politics, Economy, Technology, Entertainment...)
  category        String  @db.VarChar(60) @default("General")
  // Thumbnail (stored in Media table)
  imageId         Int?
  image           Media?  @relation(fields: [imageId], references: [id])

  startDate       DateTime?
  endDate         DateTime?
  publishedAt     DateTime?
  authorId        Int
  seoTitle        String?
  seoDescription  String?
  seoKeywords     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  author          User    @relation(fields: [authorId], references: [id])
}

// Banner/Slider
model BannerSlider {
  id              Int     @id @default(autoincrement())
  title           String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items           BannerItem[]
}

model BannerItem {
  id              Int     @id @default(autoincrement())
  sliderId        Int
  mediaId         Int
  position        Int
  timing          Int     @default(5) // Duration in seconds
  link            String?
  altText         String?

  slider          BannerSlider @relation(fields: [sliderId], references: [id], onDelete: Cascade)
  media           Media @relation(fields: [mediaId], references: [id])
}

// Media Management
model Media {
  id              Int     @id @default(autoincrement())
  filename        String
  mimeType        String  // jpg, png, webp, mp4, pdf, docx
  size            Int     // bytes
  folder          String  @default("general")
  url             String
  uploadedById    Int
  createdAt       DateTime @default(now())

  uploadedBy      User    @relation(fields: [uploadedById], references: [id])
  bannerItems     BannerItem[]
  aboutSections   AboutSection[]
  news            News[]

  @@unique([filename, folder])
}

// Contact Messages
model Contact {
  id              Int     @id @default(autoincrement())
  name            String
  email           String
  subject         String? @db.VarChar(500)
  phone           String?
  message         String  @db.Text
  status          String  @default("New") // New, Read, Replied, Archived
  submittedById    Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  submittedBy     User?   @relation(fields: [submittedById], references: [id])
}

// About Page Sections (removed duplicate - using the one below)

// Site Settings
model SiteSetting {
  id              Int     @id @default(autoincrement())
  key             String  @unique
  value           String  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Overrides for public/admin UI strings (merged with code defaults on the client).
model UiMessage {
  id          Int      @id @default(autoincrement())
  locale      String   @db.VarChar(20)
  messageKey  String   @map("message_key") @db.VarChar(190)
  value       String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([locale, messageKey])
  @@index([locale])
  @@map("ui_messages")
}

model AboutSection {
  id          Int      @id @default(autoincrement())
  title       String
  content     String
  order       Int
  imageId     Int?
  type        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  image       Media?   @relation(fields: [imageId], references: [id])
}

model PrivacyPolicy {
  id              Int      @id @default(autoincrement())
  version         String
  content         String
  slug            String   @unique
  metaTitle       String?
  metaDescription String?
  isActive        Boolean  @default(true)
  publishedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdById     Int?
  createdBy       User?    @relation("CreatedPrivacyPolicies", fields: [createdById], references: [id])
}

model TermsOfService {
  id              Int      @id @default(autoincrement())
  version         String
  content         String
  slug            String   @unique
  metaTitle       String?
  metaDescription String?
  isActive        Boolean  @default(true)
  publishedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdById     Int?
  createdBy       User?    @relation("CreatedTermsOfServices", fields: [createdById], references: [id])
}

// -------------------- Authorization Models --------------------
// Permissions and assignments for RBAC (Users, Roles, Permissions)
model Permission {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
  userPermissions UserPermission[]
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  permissionId Int

  role        Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission  Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserPermission {
  id           Int        @id @default(autoincrement())
  userId       Int
  permissionId Int

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission  Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
}

// -------------------- Admin audit log (DB-backed; view ADMIN+, mutate SYSADMIN only in API) --------------------
model AdminLogEntry {
  id        Int       @id @default(autoincrement())
  level     String    @db.VarChar(20)
  category  String?   @db.VarChar(120)
  message   String    @db.VarChar(2000)
  metadata  Json?
  traceId   String?   @map("trace_id") @db.VarChar(64)
  note      String?   @db.Text
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([createdAt])
  @@map("admin_log_entries")
}

// -------------------- Home Page Models --------------------
model HomeFeature {
  id          Int      @id @default(autoincrement())
  icon        String   @db.VarChar(50)
  title       String   @db.VarChar(150)
  titleVi     String?  @map("title_vi") @db.VarChar(150)
  description String   @db.Text
  descriptionVi String? @map("description_vi") @db.Text
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, order])
}

// -------------------- About Page Models --------------------
model AboutStat {
  id        Int      @id @default(autoincrement())
  number    String   @db.VarChar(50)
  label     String   @db.VarChar(150)
  labelVi   String?  @map("label_vi") @db.VarChar(150)
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
}

model AboutTeamMember {
  id        Int      @id @default(autoincrement())
  emoji     String   @db.VarChar(50)
  name      String   @db.VarChar(150)
  nameVi    String?  @map("name_vi") @db.VarChar(150)
  role      String   @db.VarChar(150)
  roleVi    String?  @map("role_vi") @db.VarChar(150)
  bio       String   @db.Text
  bioVi     String?  @map("bio_vi") @db.Text
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
}

// -------------------- Services Page Models --------------------
model ServiceItem {
  id        Int      @id @default(autoincrement())
  icon      String   @db.VarChar(50)
  title     String   @db.VarChar(150)
  titleVi   String?  @map("title_vi") @db.VarChar(150)
  description String @db.Text
  descriptionVi String? @map("description_vi") @db.Text
  features  String?  @db.Text // JSON array of strings
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
}

enum HospitalityRoomType {
  HOTEL
  VILLA
  RESORT
  HOMESTAY
}

enum HospitalityBookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  PENDING_PAYMENT
  PAID
}

enum HospitalityPaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model HospitalityRoom {
  id             Int                  @id @default(autoincrement())
  name           String               @db.VarChar(160)
  slug           String               @unique @db.VarChar(180)
  type           HospitalityRoomType
  shortDesc      String               @map("short_desc") @db.VarChar(500)
  details        String               @db.Text
  nightPriceUsd  Decimal              @map("night_price_usd") @db.Decimal(10, 2)
  maxGuests      Int                  @default(2) @map("max_guests")
  totalUnits     Int                  @default(1) @map("total_units")
  amenities      Json                 @default("[]")
  coverImageUrl  String?              @map("cover_image_url") @db.VarChar(2000)
  galleryImageUrls Json               @default("[]") @map("gallery_image_urls")
  isActive       Boolean              @default(true) @map("is_active")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  bookings       HospitalityBooking[]
  ratePeriods    HospitalityRatePeriod[]
  blockedDates   HospitalityBlockedDate[]

  @@index([type, isActive])
  @@map("hospitality_rooms")
}

model HospitalityRatePeriod {
  id          Int             @id @default(autoincrement())
  roomId       Int            @map("room_id")
  startDate    DateTime       @map("start_date")
  endDate      DateTime       @map("end_date")
  nightlyUsd   Decimal        @map("nightly_usd") @db.Decimal(10, 2)
  note         String?        @db.VarChar(250)
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  room         HospitalityRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, startDate, endDate, isActive])
  @@map("hospitality_rate_periods")
}

model HospitalityBlockedDate {
  id          Int             @id @default(autoincrement())
  roomId       Int            @map("room_id")
  blockedDate  DateTime       @map("blocked_date")
  reason       String?        @db.VarChar(250)
  createdAt    DateTime       @default(now()) @map("created_at")
  room         HospitalityRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, blockedDate])
  @@index([roomId, blockedDate])
  @@map("hospitality_blocked_dates")
}

model HospitalityBooking {
  id                Int                       @id @default(autoincrement())
  bookingRef        String                    @unique @map("booking_ref") @db.VarChar(36)
  roomId            Int                       @map("room_id")
  guestName         String                    @map("guest_name") @db.VarChar(160)
  guestEmail        String                    @map("guest_email") @db.VarChar(220)
  guestPhone        String?                   @map("guest_phone") @db.VarChar(50)
  checkInDate       DateTime                  @map("check_in_date")
  checkOutDate      DateTime                  @map("check_out_date")
  guests            Int                       @default(1)
  nights            Int                       @default(1)
  amountUsd         Decimal                   @map("amount_usd") @db.Decimal(10, 2)
  status            HospitalityBookingStatus  @default(PENDING)
  customerNote      String?                   @map("customer_note") @db.Text
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")
  room              HospitalityRoom           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  payments          HospitalityPayment[]

  @@index([guestEmail, createdAt])
  @@index([roomId, checkInDate, checkOutDate])
  @@index([status])
  @@map("hospitality_bookings")
}

model HospitalityPayment {
  id                Int                       @id @default(autoincrement())
  bookingId         Int                       @map("booking_id")
  paymentRef        String                    @unique @map("payment_ref") @db.VarChar(36)
  provider          String                    @db.VarChar(80)
  amountUsd         Decimal                   @map("amount_usd") @db.Decimal(10, 2)
  currency          String                    @default("USD") @db.VarChar(12)
  status            HospitalityPaymentStatus  @default(PENDING)
  providerTxnId     String?                   @map("provider_txn_id") @db.VarChar(120)
  paidAt            DateTime?                 @map("paid_at")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")
  booking           HospitalityBooking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, status])
  @@map("hospitality_payments")
}

// Singleton row (id = 1): global backup retention in days (7, 15, 30, 90, 120).
model BackupSchedule {
  id            Int      @id @default(1)
  retentionDays Int      @default(30) @map("retention_days")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("backup_schedules")
}

model BackupLog {
  id           Int      @id @default(autoincrement())
  triggeredAt  DateTime @default(now()) @map("triggered_at")
  source       String   @db.VarChar(32)
  success      Boolean
  message      String?  @db.Text
  fileName     String?  @map("file_name") @db.VarChar(500)
  deletedFiles Int      @default(0) @map("deleted_files")
  error        String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([triggeredAt])
  @@map("backup_logs")
}

