{
  "name": "vuleits-website",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend:3010": "npm run dev:3010 --workspace @vuleits/frontend",
    "build:frontend": "npm run build --workspace @vuleits/frontend",
    "build:backend": "npm run build --workspace @vuleits/backend",
    "build:backend:hosting": "npm run build:hosting --workspace @vuleits/backend",
    "start:frontend": "npm run start --workspace @vuleits/frontend",
    "start:backend": "npm run start --workspace @vuleits/backend",
    "postinstall": "node backend/scripts/prisma-with-db-env.js generate",
    "dev": "node -e \"console.log('Terminal 1: cd backend && npm run dev'); console.log('Terminal 2: cd frontend && npm run dev');\"",
    "build": "npm run build:frontend && npm run build:backend",
    "start": "npm run start:frontend",
    "lint": "eslint",
    "db:generate": "node backend/scripts/prisma-with-db-env.js generate",
    "db:push": "node backend/scripts/prisma-with-db-env.js db push",
    "db:reset": "node backend/scripts/prisma-with-db-env.js db push --force-reset --accept-data-loss",
    "seed": "node prisma/seed.js",
    "db:seed": "node prisma/seed.js",
    "db:export-snapshot": "node prisma/scripts/export-db-snapshot.js",
    "db:export-full-sql": "node prisma/scripts/export-db-full-sql.js",
    "db:seed:prisma": "npx prisma db seed",
    "db:push:seed": "npm run db:push && npm run db:seed",
    "db:ensure-user-display-name": "node prisma/scripts/ensure-user-display-name.js",
    "db:ensure-admin-permissions": "node prisma/scripts/ensure-admin-permissions.js",
    "docker:backend": "docker build -f docker/Dockerfile.backend --build-arg IMAGE_VERSION=V1.0.0 -t tuanhienvu/vuleits-website-backend:V1.0.0 .",
    "docker:frontend": "docker build -f docker/Dockerfile.frontend --build-arg IMAGE_VERSION=V1.0.0 -t tuanhienvu/vuleits-website-frontend:V1.0.0 .",
    "docker:build:backend": "npm run docker:backend",
    "docker:build:frontend": "npm run docker:frontend",
    "docker:compose:up": "docker compose -f docker-compose.yaml up -d --build",
    "docker:tag:latest:backend": "docker tag tuanhienvu/vuleits-website-backend:V1.0.0 tuanhienvu/vuleits-website-backend:latest",
    "docker:tag:latest:frontend": "docker tag tuanhienvu/vuleits-website-frontend:V1.0.0 tuanhienvu/vuleits-website-frontend:latest",
    "docker:push:backend": "docker push tuanhienvu/vuleits-website-backend:V1.0.0",
    "docker:push:frontend": "docker push tuanhienvu/vuleits-website-frontend:V1.0.0",
    "docker:push:latest:backend": "docker push tuanhienvu/vuleits-website-backend:latest",
    "docker:push:latest:frontend": "docker push tuanhienvu/vuleits-website-frontend:latest",
    "docker:linux:redeploy": "bash docker/redeploy-linux.sh"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "typescript": "^5"
  }
}
