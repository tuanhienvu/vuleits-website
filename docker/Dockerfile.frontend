# syntax=docker/dockerfile:1
# Monorepo frontend (Next.js). Build from repository root:
#   docker build -f docker/Dockerfile.frontend -t tuanhienvu/vuleits-website-frontend:V1.0.0 .
#
# Build arg BACKEND_INTERNAL_URL is baked into next.config rewrites.
# Default should target the internal Docker service so frontend->backend traffic stays inside the Docker network.
# Override for split deploy: docker build --build-arg BACKEND_INTERNAL_URL=https://api.example.com ...

FROM node:20-bookworm-slim AS deps
RUN apt-get update -y && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV DATABASE_URL="mysql://dummy:dummy@127.0.0.1:3306/dummy"
COPY package.json package-lock.json ./
COPY frontend/package.json frontend/package.json
COPY backend/package.json backend/package.json
COPY backend/scripts/prisma-with-db-env.js backend/scripts/prisma-with-db-env.js
COPY backend/scripts/load-database-env.js backend/scripts/load-database-env.js
COPY prisma ./prisma
RUN npm ci

FROM deps AS builder
WORKDIR /app
COPY frontend ./frontend
ENV DATABASE_URL="mysql://dummy:dummy@127.0.0.1:3306/dummy"
ENV NODE_ENV=production
ARG BACKEND_INTERNAL_URL=http://backend:5001
ENV BACKEND_INTERNAL_URL=${BACKEND_INTERNAL_URL}
RUN npm run build --workspace @vuleits/frontend

FROM node:20-bookworm-slim AS runner
ARG IMAGE_VERSION=V1.0.0
LABEL org.opencontainers.image.title="vuleits-website-frontend" \
  org.opencontainers.image.version="${IMAGE_VERSION}"
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3001
ENV HOSTNAME=0.0.0.0
ENV SERVICE_VERSION=${IMAGE_VERSION}

RUN apt-get update -y && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/frontend ./frontend

EXPOSE 3001
CMD ["npm", "run", "start", "--workspace", "@vuleits/frontend"]
